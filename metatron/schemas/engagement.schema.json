{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/metatron/engagement.schema.json",
  "title": "Metatron engagement contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement_id",
    "title",
    "authorized_by",
    "starts_at",
    "expires_at",
    "network_policy",
    "scope"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "engagement_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "authorized_by": { "type": "string", "minLength": 1 },
    "starts_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "network_policy": {
      "enum": ["loopback_only", "private_and_loopback", "public_only"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "allowed_actions"],
        "properties": {
          "origin": { "type": "string", "format": "uri" },
          "allowed_actions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["http_observe", "ai_assess"] }
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": { "mode": { "const": "none" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "username_env", "password_env"],
                "properties": {
                  "mode": { "const": "basic" },
                  "username_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "password_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "token_env"],
                "properties": {
                  "mode": { "const": "bearer" },
                  "token_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
