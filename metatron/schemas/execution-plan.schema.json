{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/metatron/execution-plan.schema.json",
  "title": "Metatron execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "engagement_id", "target_origin", "tools", "risks", "created_at", "expires_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "target_origin": { "type": "string", "format": "uri" },
    "tools": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["dns", "http_headers", "whois", "nmap_service", "whatweb", "nikto"] }
    },
    "risks": { "type": "array", "minItems": 1, "items": { "enum": ["passive", "active", "noisy"] } },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
