{
  "id": "metatron",
  "version": 2,
  "status": "dormant",
  "owner": "Alexandre Carron",
  "activation": "Commande CLI explicite après contrat, plan et approbation exacte",
  "inputs": ["schemas/engagement.schema.json", "schemas/execution-plan.schema.json", "objectif opérateur"],
  "tools": ["dns", "http_headers", "whois", "nmap_service", "whatweb", "nikto"],
  "outputs": ["preuves JSON", "schemas/assessment.schema.json", "journal JSONL sans secret"],
  "budgets": {
    "tool_runs_per_plan": 20,
    "plan_ttl_minutes": 60,
    "redirects": 0,
    "model_calls_per_assessment": 1
  },
  "stop_conditions": [
    "contrat absent, invalide ou expiré",
    "origine ou outil hors périmètre",
    "résolution DNS incompatible avec la politique réseau",
    "plan altéré, non approuvé ou expiré",
    "approbation bruyante absente",
    "secret référencé absent",
    "sortie IA invalide"
  ],
  "prohibited": [
    "outil ou argument choisi par le modèle",
    "exploitation autonome",
    "persistance",
    "évasion",
    "déni de service",
    "mouvement latéral"
  ],
  "relations": [],
  "evaluations": [
    "metatron.scope-denial",
    "metatron.plan-integrity",
    "metatron.secret-isolation",
    "metatron.prompt-injection-boundary",
    "metatron.grounded-assessment"
  ]
}
